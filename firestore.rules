rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin tem acesso total (por role/permissions no Firestore ou email absoluto)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'mariomarciofranco@gmail.com' ||
        request.auth.token.email == 'jardimcalifornia@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('admin', false) == true
          )
        )
      );
    }

    // Usuário autenticado genérico
    function isAuth() {
      return request.auth != null;
    }

    // Usuário dono do documento (para settings)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // === COLEÇÃO: publishers ===
    match /publishers/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // === COLEÇÃO: groups ===
    match /groups/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // === COLEÇÃO: territories ===
    match /territories/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // === COLEÇÃO: midweek_meetings ===
    match /midweek_meetings/{docId} {
      allow read, write: if isAuth();
    }

    // === COLEÇÃO: weekend_meetings ===
    match /weekend_meetings/{docId} {
      allow read, write: if isAuth();
    }

    // === COLEÇÃO: attendance ===
    match /attendance/{docId} {
      allow read, write: if isAuth();
    }

    // === COLEÇÃO: field_reports ===
    match /field_reports/{docId} {
      allow read, write: if isAuth();
    }

    // === COLEÇÃO: public_witness ===
    match /public_witness/{docId} {
      allow read, write: if isAuth();
    }

    // === COLEÇÃO: users (protegida - só admin pode escrever) ===
    match /users/{docId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin() || docId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // === COLEÇÃO: settings ===
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isOwner(docId);
    }

    // === ARRANJO DE ÔNIBUS ===

    // Responsável pelo arranjo (um dos 2 managers) ou admin
    function isBusManager(arrangementId) {
      return isAuth() && (
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/bus_arrangements/$(arrangementId)).data.managers ||
        request.auth.uid in get(/databases/$(database)/documents/bus_arrangements/$(arrangementId)).data.get('managerUids', [])
      );
    }

    // Registro do arranjo: todos veem, só os 2 responsáveis alteram
    match /bus_arrangements/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || (
        isAuth() && (
          request.auth.uid in resource.data.managers ||
          request.auth.uid in resource.data.get('managerUids', [])
        )
      );
      allow delete: if isAdmin();
    }

    // Depósitos e comprovantes bancários
    match /bus_deposits/{docId} {
      allow read: if isAuth();
      allow create: if isBusManager(request.resource.data.arrangementId);
      allow update, delete: if isBusManager(resource.data.arrangementId);

      // Foto do comprovante (subcoleção, fora do documento principal por causa do limite de 1 MB)
      match /photo/{photoId} {
        allow read: if isAuth();
        allow create, update: if isBusManager(get(/databases/$(database)/documents/bus_deposits/$(docId)).data.arrangementId);
        allow delete: if isBusManager(get(/databases/$(database)/documents/bus_deposits/$(docId)).data.arrangementId);
      }
    }
  }
}
